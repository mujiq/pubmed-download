{
  "resourceType": "StructureDefinition",
  "id": "healix-encounter",
  "url": "https://fhir.healix.example.org/StructureDefinition/healix-encounter",
  "version": "0.1.0",
  "name": "HealixEncounter",
  "title": "HEALIX Encounter Profile",
  "status": "draft",
  "experimental": false,
  "date": "2026-10-17",
  "publisher": "HEALIX Data Platform & Clinical Informatics",
  "description": "HEALIX-Clinical constraint on US Core 6.1.0 Encounter: mandatory meta.source/profile, FIN and Cerner encounter id identifier slices, required binding of class to healix-encounter-class, extensible bindings of admitSource and dischargeDisposition to HEALIX value sets, mandatory period.start and serviceProvider, and HEALIX reference profiles.",
  "jurisdiction": [{"coding": [{"system": "urn:iso:std:iso:3166", "code": "US"}]}],
  "fhirVersion": "4.0.1",
  "kind": "resource",
  "abstract": false,
  "type": "Encounter",
  "baseDefinition": "http://hl7.org/fhir/us/core/StructureDefinition/us-core-encounter",
  "derivation": "constraint",
  "differential": {
    "element": [
      {"id": "Encounter", "path": "Encounter", "short": "HEALIX canonical Encounter (G2 Clinical Care)",
       "constraint": [
         {"key": "hx-enc-1", "severity": "error", "human": "A finished encounter must have period.end", "expression": "status = 'finished' implies period.end.exists()"},
         {"key": "hx-enc-2", "severity": "error", "human": "period.end must not precede period.start", "expression": "period.end.empty() or period.start.empty() or period.end >= period.start"},
         {"key": "hx-enc-3", "severity": "warning", "human": "Inpatient encounters should carry hospitalization details", "expression": "class.code = 'IMP' implies hospitalization.exists()"}
       ]},
      {"id": "Encounter.meta", "path": "Encounter.meta", "min": 1, "mustSupport": true},
      {"id": "Encounter.meta.source", "path": "Encounter.meta.source", "min": 1, "mustSupport": true},
      {"id": "Encounter.meta.profile", "path": "Encounter.meta.profile", "min": 1, "max": "1", "mustSupport": true},
      {"id": "Encounter.identifier", "path": "Encounter.identifier", "slicing": {"discriminator": [{"type": "value", "path": "system"}], "rules": "open"}, "min": 1, "mustSupport": true},
      {"id": "Encounter.identifier.system", "path": "Encounter.identifier.system", "min": 1},
      {"id": "Encounter.identifier.value", "path": "Encounter.identifier.value", "min": 1},
      {"id": "Encounter.identifier:fin", "path": "Encounter.identifier", "sliceName": "fin", "short": "Cerner Financial Number (FIN NBR) — primary business key", "min": 1, "max": "1", "mustSupport": true},
      {"id": "Encounter.identifier:fin.type", "path": "Encounter.identifier.type", "patternCodeableConcept": {"coding": [{"system": "http://terminology.hl7.org/CodeSystem/v2-0203", "code": "AN"}]}},
      {"id": "Encounter.identifier:fin.system", "path": "Encounter.identifier.system", "min": 1, "fixedUri": "https://id.healix.example.org/cerner/fin"},
      {"id": "Encounter.identifier:cernerEncntrId", "path": "Encounter.identifier", "sliceName": "cernerEncntrId", "short": "Cerner ENCOUNTER.ENCNTR_ID", "min": 0, "max": "1"},
      {"id": "Encounter.identifier:cernerEncntrId.type", "path": "Encounter.identifier.type", "patternCodeableConcept": {"coding": [{"system": "http://terminology.hl7.org/CodeSystem/v2-0203", "code": "VN"}]}},
      {"id": "Encounter.identifier:cernerEncntrId.system", "path": "Encounter.identifier.system", "min": 1, "fixedUri": "https://id.healix.example.org/cerner/encntr-id"},
      {"id": "Encounter.status", "path": "Encounter.status", "mustSupport": true, "binding": {"strength": "required", "valueSet": "https://fhir.healix.example.org/ValueSet/healix-encounter-status"}},
      {"id": "Encounter.class", "path": "Encounter.class", "short": "Translated from Cerner code set 71 via ConceptMap cerner-encounter-type-to-healix", "min": 1, "mustSupport": true, "binding": {"strength": "required", "valueSet": "https://fhir.healix.example.org/ValueSet/healix-encounter-class"}},
      {"id": "Encounter.type", "path": "Encounter.type", "min": 1, "mustSupport": true, "binding": {"strength": "extensible", "valueSet": "https://fhir.healix.example.org/ValueSet/healix-encounter-type"}},
      {"id": "Encounter.serviceType", "path": "Encounter.serviceType", "mustSupport": true, "binding": {"strength": "required", "valueSet": "https://fhir.healix.example.org/ValueSet/healix-service-line"}},
      {"id": "Encounter.subject", "path": "Encounter.subject", "min": 1, "type": [{"code": "Reference", "targetProfile": ["https://fhir.healix.example.org/StructureDefinition/healix-patient"]}], "mustSupport": true},
      {"id": "Encounter.subject.identifier", "path": "Encounter.subject.identifier", "short": "Business identifier (MRN or EMPI) in addition to literal reference", "min": 1},
      {"id": "Encounter.participant", "path": "Encounter.participant", "mustSupport": true},
      {"id": "Encounter.participant.type", "path": "Encounter.participant.type", "min": 1, "binding": {"strength": "extensible", "valueSet": "http://hl7.org/fhir/ValueSet/encounter-participant-type"}},
      {"id": "Encounter.participant.individual", "path": "Encounter.participant.individual", "type": [{"code": "Reference", "targetProfile": ["https://fhir.healix.example.org/StructureDefinition/healix-practitioner", "https://fhir.healix.example.org/StructureDefinition/healix-practitionerrole"]}]},
      {"id": "Encounter.period", "path": "Encounter.period", "min": 1, "mustSupport": true},
      {"id": "Encounter.period.start", "path": "Encounter.period.start", "min": 1, "mustSupport": true},
      {"id": "Encounter.diagnosis", "path": "Encounter.diagnosis", "mustSupport": true},
      {"id": "Encounter.diagnosis.condition", "path": "Encounter.diagnosis.condition", "type": [{"code": "Reference", "targetProfile": ["https://fhir.healix.example.org/StructureDefinition/healix-condition"]}]},
      {"id": "Encounter.diagnosis.use", "path": "Encounter.diagnosis.use", "min": 1, "binding": {"strength": "required", "valueSet": "https://fhir.healix.example.org/ValueSet/healix-diagnosis-role"}},
      {"id": "Encounter.hospitalization", "path": "Encounter.hospitalization", "mustSupport": true},
      {"id": "Encounter.hospitalization.admitSource", "path": "Encounter.hospitalization.admitSource", "mustSupport": true, "binding": {"strength": "extensible", "valueSet": "https://fhir.healix.example.org/ValueSet/healix-admit-source"}},
      {"id": "Encounter.hospitalization.dischargeDisposition", "path": "Encounter.hospitalization.dischargeDisposition", "mustSupport": true, "binding": {"strength": "extensible", "valueSet": "https://fhir.healix.example.org/ValueSet/healix-discharge-disposition"}},
      {"id": "Encounter.location", "path": "Encounter.location", "short": "Facility → point of care → room → bed hierarchy from PL datatype", "mustSupport": true},
      {"id": "Encounter.location.location", "path": "Encounter.location.location", "type": [{"code": "Reference", "targetProfile": ["https://fhir.healix.example.org/StructureDefinition/healix-location"]}]},
      {"id": "Encounter.location.status", "path": "Encounter.location.status", "min": 1},
      {"id": "Encounter.location.period", "path": "Encounter.location.period", "min": 1},
      {"id": "Encounter.serviceProvider", "path": "Encounter.serviceProvider", "min": 1, "type": [{"code": "Reference", "targetProfile": ["https://fhir.healix.example.org/StructureDefinition/healix-organization"]}], "mustSupport": true}
    ]
  }
}
