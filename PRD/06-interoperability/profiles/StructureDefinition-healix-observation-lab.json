{
  "resourceType": "StructureDefinition",
  "id": "healix-observation-lab",
  "url": "https://fhir.healix.example.org/StructureDefinition/healix-observation-lab",
  "version": "0.1.0",
  "name": "HealixObservationLab",
  "title": "HEALIX Laboratory Result Observation Profile",
  "status": "draft",
  "experimental": false,
  "date": "2026-10-17",
  "publisher": "HEALIX Data Platform & Clinical Informatics",
  "description": "HEALIX-Clinical constraint on US Core 6.1.0 Laboratory Result Observation: mandatory meta.source/profile, filler/placer identifier slices, LOINC coding slice on code with the local LIS/Cerner code retained, required status and interpretation bindings, UCUM units, mandatory effective and performer, specimen and encounter references to HEALIX profiles.",
  "jurisdiction": [{"coding": [{"system": "urn:iso:std:iso:3166", "code": "US"}]}],
  "fhirVersion": "4.0.1",
  "kind": "resource",
  "abstract": false,
  "type": "Observation",
  "baseDefinition": "http://hl7.org/fhir/us/core/StructureDefinition/us-core-observation-lab",
  "derivation": "constraint",
  "differential": {
    "element": [
      {"id": "Observation", "path": "Observation", "short": "HEALIX canonical laboratory Observation (G2 Clinical Care)",
       "constraint": [
         {"key": "hx-lab-1", "severity": "error", "human": "A quantity value must carry a UCUM code", "expression": "value.ofType(Quantity).exists() implies (value.ofType(Quantity).system = 'http://unitsofmeasure.org' and value.ofType(Quantity).code.exists())"},
         {"key": "hx-lab-2", "severity": "error", "human": "A final/amended/corrected result must have a value or a dataAbsentReason or components", "expression": "(status = 'final' or status = 'amended' or status = 'corrected') implies (value.exists() or dataAbsentReason.exists() or component.exists())"}
       ]},
      {"id": "Observation.meta", "path": "Observation.meta", "min": 1, "mustSupport": true},
      {"id": "Observation.meta.source", "path": "Observation.meta.source", "min": 1, "mustSupport": true},
      {"id": "Observation.meta.profile", "path": "Observation.meta.profile", "min": 1, "max": "1", "mustSupport": true},
      {"id": "Observation.identifier", "path": "Observation.identifier", "slicing": {"discriminator": [{"type": "value", "path": "system"}], "rules": "open"}, "min": 1, "mustSupport": true},
      {"id": "Observation.identifier:fillerOrder", "path": "Observation.identifier", "sliceName": "fillerOrder", "short": "OBR-3 / ORC-3 filler order number plus OBX-4 sub-id suffix", "min": 1, "max": "1", "mustSupport": true},
      {"id": "Observation.identifier:fillerOrder.type", "path": "Observation.identifier.type", "patternCodeableConcept": {"coding": [{"system": "http://terminology.hl7.org/CodeSystem/v2-0203", "code": "FILL"}]}},
      {"id": "Observation.identifier:fillerOrder.system", "path": "Observation.identifier.system", "min": 1, "fixedUri": "https://id.healix.example.org/cerner/filler-order"},
      {"id": "Observation.identifier:fillerOrder.value", "path": "Observation.identifier.value", "min": 1},
      {"id": "Observation.identifier:accession", "path": "Observation.identifier", "sliceName": "accession", "short": "LIS accession number", "min": 0, "max": "1"},
      {"id": "Observation.identifier:accession.type", "path": "Observation.identifier.type", "patternCodeableConcept": {"coding": [{"system": "http://terminology.hl7.org/CodeSystem/v2-0203", "code": "ACSN"}]}},
      {"id": "Observation.identifier:accession.system", "path": "Observation.identifier.system", "min": 1, "fixedUri": "https://id.healix.example.org/lis/accession"},
      {"id": "Observation.basedOn", "path": "Observation.basedOn", "type": [{"code": "Reference", "targetProfile": ["https://fhir.healix.example.org/StructureDefinition/healix-servicerequest"]}], "mustSupport": true},
      {"id": "Observation.status", "path": "Observation.status", "mustSupport": true, "binding": {"strength": "required", "valueSet": "https://fhir.healix.example.org/ValueSet/healix-lab-result-status"}},
      {"id": "Observation.code", "path": "Observation.code", "mustSupport": true, "binding": {"strength": "extensible", "valueSet": "https://fhir.healix.example.org/ValueSet/healix-lab-observation-code"}},
      {"id": "Observation.code.coding", "path": "Observation.code.coding", "slicing": {"discriminator": [{"type": "value", "path": "system"}], "rules": "open"}, "min": 1},
      {"id": "Observation.code.coding:loinc", "path": "Observation.code.coding", "sliceName": "loinc", "short": "LOINC code obtained via Terminology Service $translate; absent only when tagged unmapped", "min": 0, "max": "1", "mustSupport": true},
      {"id": "Observation.code.coding:loinc.system", "path": "Observation.code.coding.system", "min": 1, "fixedUri": "http://loinc.org"},
      {"id": "Observation.code.coding:loinc.code", "path": "Observation.code.coding.code", "min": 1},
      {"id": "Observation.code.coding:local", "path": "Observation.code.coding", "sliceName": "local", "short": "Original OBX-3 code from Cerner/LIS code system, userSelected = true", "min": 1, "max": "*"},
      {"id": "Observation.code.coding:local.system", "path": "Observation.code.coding.system", "min": 1},
      {"id": "Observation.code.coding:local.code", "path": "Observation.code.coding.code", "min": 1},
      {"id": "Observation.code.coding:local.userSelected", "path": "Observation.code.coding.userSelected", "min": 1, "fixedBoolean": true},
      {"id": "Observation.subject", "path": "Observation.subject", "min": 1, "type": [{"code": "Reference", "targetProfile": ["https://fhir.healix.example.org/StructureDefinition/healix-patient"]}], "mustSupport": true},
      {"id": "Observation.encounter", "path": "Observation.encounter", "type": [{"code": "Reference", "targetProfile": ["https://fhir.healix.example.org/StructureDefinition/healix-encounter"]}], "mustSupport": true},
      {"id": "Observation.effective[x]", "path": "Observation.effective[x]", "min": 1, "type": [{"code": "dateTime"}, {"code": "Period"}], "mustSupport": true},
      {"id": "Observation.issued", "path": "Observation.issued", "mustSupport": true},
      {"id": "Observation.performer", "path": "Observation.performer", "min": 1, "type": [{"code": "Reference", "targetProfile": ["https://fhir.healix.example.org/StructureDefinition/healix-organization", "https://fhir.healix.example.org/StructureDefinition/healix-practitioner", "https://fhir.healix.example.org/StructureDefinition/healix-practitionerrole"]}], "mustSupport": true},
      {"id": "Observation.value[x]", "path": "Observation.value[x]", "mustSupport": true},
      {"id": "Observation.value[x]:valueQuantity", "path": "Observation.value[x]", "sliceName": "valueQuantity", "type": [{"code": "Quantity"}], "mustSupport": true},
      {"id": "Observation.value[x]:valueQuantity.system", "path": "Observation.value[x].system", "min": 1, "fixedUri": "http://unitsofmeasure.org"},
      {"id": "Observation.value[x]:valueQuantity.code", "path": "Observation.value[x].code", "min": 1, "binding": {"strength": "required", "valueSet": "https://fhir.healix.example.org/ValueSet/healix-unit-of-measure"}},
      {"id": "Observation.interpretation", "path": "Observation.interpretation", "mustSupport": true, "binding": {"strength": "required", "valueSet": "https://fhir.healix.example.org/ValueSet/healix-observation-interpretation"}},
      {"id": "Observation.specimen", "path": "Observation.specimen", "type": [{"code": "Reference", "targetProfile": ["https://fhir.healix.example.org/StructureDefinition/healix-specimen"]}], "mustSupport": true},
      {"id": "Observation.device", "path": "Observation.device", "type": [{"code": "Reference", "targetProfile": ["https://fhir.healix.example.org/StructureDefinition/healix-device"]}]},
      {"id": "Observation.referenceRange", "path": "Observation.referenceRange", "mustSupport": true}
    ]
  }
}
