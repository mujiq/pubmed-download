{
  "resourceType": "StructureDefinition",
  "id": "healix-patient",
  "url": "https://fhir.healix.example.org/StructureDefinition/healix-patient",
  "version": "0.1.0",
  "name": "HealixPatient",
  "title": "HEALIX Patient Profile",
  "status": "draft",
  "experimental": false,
  "date": "2026-10-17",
  "publisher": "HEALIX Data Platform & Clinical Informatics",
  "description": "HEALIX-Clinical constraint on US Core 6.1.0 Patient: mandatory meta.source and meta.profile, identifier slices for the enterprise identifier systems (EMPI, Cerner MRN, Cerner person id), prohibition of SSN, and the valid-period extension for bitemporal projection.",
  "jurisdiction": [{"coding": [{"system": "urn:iso:std:iso:3166", "code": "US"}]}],
  "fhirVersion": "4.0.1",
  "kind": "resource",
  "abstract": false,
  "type": "Patient",
  "baseDefinition": "http://hl7.org/fhir/us/core/StructureDefinition/us-core-patient",
  "derivation": "constraint",
  "differential": {
    "element": [
      {"id": "Patient", "path": "Patient", "short": "HEALIX canonical Patient (G1 Party & Identity)"},
      {"id": "Patient.meta", "path": "Patient.meta", "min": 1, "mustSupport": true},
      {"id": "Patient.meta.source", "path": "Patient.meta.source", "short": "Source Registry URI of the originating system/interface", "min": 1, "mustSupport": true},
      {"id": "Patient.meta.profile", "path": "Patient.meta.profile", "min": 1, "max": "1", "mustSupport": true},
      {"id": "Patient.meta.tag", "path": "Patient.meta.tag", "binding": {"strength": "required", "valueSet": "https://fhir.healix.example.org/ValueSet/healix-record-flags"}},
      {"id": "Patient.extension", "path": "Patient.extension", "slicing": {"discriminator": [{"type": "value", "path": "url"}], "rules": "open"}},
      {"id": "Patient.extension:validPeriod", "path": "Patient.extension", "sliceName": "validPeriod", "min": 0, "max": "1", "type": [{"code": "Extension", "profile": ["https://fhir.healix.example.org/StructureDefinition/ext-valid-period"]}]},
      {"id": "Patient.identifier", "path": "Patient.identifier", "slicing": {"discriminator": [{"type": "value", "path": "system"}], "rules": "open", "description": "Sliced by identifier system URI from profiles/identifier-systems.yaml"}, "min": 1, "mustSupport": true},
      {"id": "Patient.identifier.system", "path": "Patient.identifier.system", "min": 1, "mustSupport": true},
      {"id": "Patient.identifier.value", "path": "Patient.identifier.value", "min": 1, "mustSupport": true},
      {"id": "Patient.identifier:empi", "path": "Patient.identifier", "sliceName": "empi", "short": "Enterprise person identifier assigned by HEALIX entity resolution", "min": 1, "max": "1", "mustSupport": true},
      {"id": "Patient.identifier:empi.type", "path": "Patient.identifier.type", "patternCodeableConcept": {"coding": [{"system": "http://terminology.hl7.org/CodeSystem/v2-0203", "code": "PI"}]}},
      {"id": "Patient.identifier:empi.system", "path": "Patient.identifier.system", "min": 1, "fixedUri": "https://id.healix.example.org/empi/enterprise-id"},
      {"id": "Patient.identifier:mrn", "path": "Patient.identifier", "sliceName": "mrn", "short": "Cerner Millennium Medical Record Number", "min": 0, "max": "*", "mustSupport": true},
      {"id": "Patient.identifier:mrn.type", "path": "Patient.identifier.type", "patternCodeableConcept": {"coding": [{"system": "http://terminology.hl7.org/CodeSystem/v2-0203", "code": "MR"}]}},
      {"id": "Patient.identifier:mrn.system", "path": "Patient.identifier.system", "min": 1, "fixedUri": "https://id.healix.example.org/cerner/mrn"},
      {"id": "Patient.identifier:cernerPersonId", "path": "Patient.identifier", "sliceName": "cernerPersonId", "short": "Cerner PERSON.PERSON_ID", "min": 0, "max": "1"},
      {"id": "Patient.identifier:cernerPersonId.system", "path": "Patient.identifier.system", "min": 1, "fixedUri": "https://id.healix.example.org/cerner/person-id"},
      {"id": "Patient.identifier:mbi", "path": "Patient.identifier", "sliceName": "mbi", "short": "Medicare Beneficiary Identifier", "min": 0, "max": "1"},
      {"id": "Patient.identifier:mbi.system", "path": "Patient.identifier.system", "min": 1, "fixedUri": "http://hl7.org/fhir/sid/us-mbi"},
      {"id": "Patient.identifier:ssnToken", "path": "Patient.identifier", "sliceName": "ssnToken", "short": "Module 11 keyed hash token of SSN; raw SSN is prohibited", "min": 0, "max": "1"},
      {"id": "Patient.identifier:ssnToken.system", "path": "Patient.identifier.system", "min": 1, "fixedUri": "https://id.healix.example.org/empi/ssn-token"},
      {"id": "Patient.active", "path": "Patient.active", "min": 1, "mustSupport": true},
      {"id": "Patient.name", "path": "Patient.name", "min": 1},
      {"id": "Patient.gender", "path": "Patient.gender", "min": 1},
      {"id": "Patient.birthDate", "path": "Patient.birthDate", "min": 1, "mustSupport": true},
      {"id": "Patient.deceased[x]", "path": "Patient.deceased[x]", "mustSupport": true},
      {"id": "Patient.managingOrganization", "path": "Patient.managingOrganization", "min": 1, "type": [{"code": "Reference", "targetProfile": ["https://fhir.healix.example.org/StructureDefinition/healix-organization"]}], "mustSupport": true},
      {"id": "Patient.link", "path": "Patient.link", "short": "Populated by ADT A40 merges and EMPI survivorship", "mustSupport": true},
      {"id": "Patient.link.other", "path": "Patient.link.other", "type": [{"code": "Reference", "targetProfile": ["https://fhir.healix.example.org/StructureDefinition/healix-patient"]}]}
    ]
  }
}
