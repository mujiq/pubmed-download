{
  "resourceType": "StructureDefinition",
  "id": "healix-erp-gl-journal-line",
  "url": "https://fhir.healix.example.org/StructureDefinition/healix-erp-gl-journal-line",
  "version": "0.1.0",
  "name": "HealixErpGlJournalLine",
  "title": "HEALIX ERP General Ledger Journal Line (Basic)",
  "status": "draft",
  "experimental": false,
  "date": "2026-10-17",
  "publisher": "HEALIX Data Platform & Enterprise Architecture",
  "description": "HEALIX-ERP profile on Basic representing one Oracle Fusion General Ledger journal line (GL_JE_LINES joined to GL_JE_HEADERS and GL_CODE_COMBINATIONS). Basic.code is fixed to gl-journal-line; business attributes are carried as sliced, typed extensions; Basic.subject is the legal entity Organization; Basic.created is the accounting effective date. No custom resource type is used.",
  "jurisdiction": [{"coding": [{"system": "urn:iso:std:iso:3166", "code": "US"}]}],
  "fhirVersion": "4.0.1",
  "kind": "resource",
  "abstract": false,
  "type": "Basic",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/Basic",
  "derivation": "constraint",
  "differential": {
    "element": [
      {"id": "Basic", "path": "Basic", "short": "GL journal line (G3 Revenue Cycle & Finance)",
       "constraint": [
         {"key": "hx-gl-1", "severity": "error", "human": "Exactly one of entered debit or entered credit amount must be present and the other absent or zero", "expression": "(extension('https://fhir.healix.example.org/StructureDefinition/ext-erp-entered-debit').exists() xor extension('https://fhir.healix.example.org/StructureDefinition/ext-erp-entered-credit').exists()) or (extension('https://fhir.healix.example.org/StructureDefinition/ext-erp-entered-debit').value.value = 0 or extension('https://fhir.healix.example.org/StructureDefinition/ext-erp-entered-credit').value.value = 0)"},
         {"key": "hx-gl-2", "severity": "error", "human": "Accounted amount currency must equal ledger currency", "expression": "extension('https://fhir.healix.example.org/StructureDefinition/ext-erp-accounted-amount').value.currency = extension('https://fhir.healix.example.org/StructureDefinition/ext-erp-ledger-currency').value"}
       ]},
      {"id": "Basic.meta", "path": "Basic.meta", "min": 1, "mustSupport": true},
      {"id": "Basic.meta.source", "path": "Basic.meta.source", "min": 1, "mustSupport": true, "short": "e.g. https://id.healix.example.org/source/oracle-fusion-erp/gl-bicc"},
      {"id": "Basic.meta.profile", "path": "Basic.meta.profile", "min": 1, "max": "1", "mustSupport": true},
      {"id": "Basic.extension", "path": "Basic.extension", "slicing": {"discriminator": [{"type": "value", "path": "url"}], "rules": "open"}, "min": 6},
      {"id": "Basic.extension:ledger", "path": "Basic.extension", "sliceName": "ledger", "short": "Oracle GL ledger as Organization (type ledger)", "min": 1, "max": "1", "type": [{"code": "Extension", "profile": ["https://fhir.healix.example.org/StructureDefinition/ext-erp-ledger"]}], "mustSupport": true},
      {"id": "Basic.extension:ledgerCurrency", "path": "Basic.extension", "sliceName": "ledgerCurrency", "short": "ISO 4217 ledger currency (valueCode)", "min": 1, "max": "1", "type": [{"code": "Extension", "profile": ["https://fhir.healix.example.org/StructureDefinition/ext-erp-ledger-currency"]}]},
      {"id": "Basic.extension:journalHeader", "path": "Basic.extension", "sliceName": "journalHeader", "short": "GL_JE_HEADERS.JE_HEADER_ID as Identifier", "min": 1, "max": "1", "type": [{"code": "Extension", "profile": ["https://fhir.healix.example.org/StructureDefinition/ext-erp-journal-header"]}], "mustSupport": true},
      {"id": "Basic.extension:journalLineNumber", "path": "Basic.extension", "sliceName": "journalLineNumber", "short": "GL_JE_LINES.JE_LINE_NUM (valueInteger)", "min": 1, "max": "1", "type": [{"code": "Extension", "profile": ["https://fhir.healix.example.org/StructureDefinition/ext-erp-journal-line-number"]}], "mustSupport": true},
      {"id": "Basic.extension:accountCombination", "path": "Basic.extension", "sliceName": "accountCombination", "short": "Chart-of-accounts code combination: complex extension with segment[] (name, value, description) and codeCombinationId", "min": 1, "max": "1", "type": [{"code": "Extension", "profile": ["https://fhir.healix.example.org/StructureDefinition/ext-erp-account-combination"]}], "mustSupport": true},
      {"id": "Basic.extension:costCenter", "path": "Basic.extension", "sliceName": "costCenter", "short": "Cost center segment as Organization reference (conformed dimension)", "min": 0, "max": "1", "type": [{"code": "Extension", "profile": ["https://fhir.healix.example.org/StructureDefinition/ext-erp-cost-center"]}], "mustSupport": true},
      {"id": "Basic.extension:enteredDebit", "path": "Basic.extension", "sliceName": "enteredDebit", "short": "ENTERED_DR (valueMoney, entered currency)", "min": 0, "max": "1", "type": [{"code": "Extension", "profile": ["https://fhir.healix.example.org/StructureDefinition/ext-erp-entered-debit"]}]},
      {"id": "Basic.extension:enteredCredit", "path": "Basic.extension", "sliceName": "enteredCredit", "short": "ENTERED_CR (valueMoney, entered currency)", "min": 0, "max": "1", "type": [{"code": "Extension", "profile": ["https://fhir.healix.example.org/StructureDefinition/ext-erp-entered-credit"]}]},
      {"id": "Basic.extension:accountedAmount", "path": "Basic.extension", "sliceName": "accountedAmount", "short": "Signed accounted amount in ledger currency: ACCOUNTED_DR − ACCOUNTED_CR (valueMoney)", "min": 1, "max": "1", "type": [{"code": "Extension", "profile": ["https://fhir.healix.example.org/StructureDefinition/ext-erp-accounted-amount"]}], "mustSupport": true},
      {"id": "Basic.extension:currencyConversion", "path": "Basic.extension", "sliceName": "currencyConversion", "short": "Complex: conversionType, conversionRate (decimal), conversionDate", "min": 0, "max": "1", "type": [{"code": "Extension", "profile": ["https://fhir.healix.example.org/StructureDefinition/ext-erp-currency-conversion"]}]},
      {"id": "Basic.extension:periodName", "path": "Basic.extension", "sliceName": "periodName", "short": "Accounting period name, e.g. Sep-26 (valueString)", "min": 1, "max": "1", "type": [{"code": "Extension", "profile": ["https://fhir.healix.example.org/StructureDefinition/ext-erp-period-name"]}], "mustSupport": true},
      {"id": "Basic.extension:journalSource", "path": "Basic.extension", "sliceName": "journalSource", "short": "GL journal source (valueCodeableConcept, healix-journal-source)", "min": 1, "max": "1", "type": [{"code": "Extension", "profile": ["https://fhir.healix.example.org/StructureDefinition/ext-erp-journal-source"]}]},
      {"id": "Basic.extension:journalCategory", "path": "Basic.extension", "sliceName": "journalCategory", "short": "GL journal category (valueCodeableConcept, oracle-lookup mirrored)", "min": 1, "max": "1", "type": [{"code": "Extension", "profile": ["https://fhir.healix.example.org/StructureDefinition/ext-erp-journal-category"]}]},
      {"id": "Basic.extension:postingStatus", "path": "Basic.extension", "sliceName": "postingStatus", "short": "unposted | posted | reversed | error (valueCodeableConcept, healix-gl-posting-status)", "min": 1, "max": "1", "type": [{"code": "Extension", "profile": ["https://fhir.healix.example.org/StructureDefinition/ext-erp-posting-status"]}], "mustSupport": true},
      {"id": "Basic.extension:postedDate", "path": "Basic.extension", "sliceName": "postedDate", "short": "GL_JE_HEADERS.POSTED_DATE (valueDateTime)", "min": 0, "max": "1", "type": [{"code": "Extension", "profile": ["https://fhir.healix.example.org/StructureDefinition/ext-erp-posted-date"]}]},
      {"id": "Basic.extension:lineDescription", "path": "Basic.extension", "sliceName": "lineDescription", "short": "GL_JE_LINES.DESCRIPTION (valueString); PHI-screened by agent.privacy_guardian", "min": 0, "max": "1", "type": [{"code": "Extension", "profile": ["https://fhir.healix.example.org/StructureDefinition/ext-erp-line-description"]}]},
      {"id": "Basic.extension:sourceDocument", "path": "Basic.extension", "sliceName": "sourceDocument", "short": "Reference to the originating Invoice, ChargeItem, PaymentReconciliation or Basic (PO receipt) when derivable from subledger accounting", "min": 0, "max": "*", "type": [{"code": "Extension", "profile": ["https://fhir.healix.example.org/StructureDefinition/ext-erp-source-document"]}]},
      {"id": "Basic.extension:validPeriod", "path": "Basic.extension", "sliceName": "validPeriod", "short": "Bitemporal valid time for module 08", "min": 1, "max": "1", "type": [{"code": "Extension", "profile": ["https://fhir.healix.example.org/StructureDefinition/ext-valid-period"]}]},
      {"id": "Basic.identifier", "path": "Basic.identifier", "slicing": {"discriminator": [{"type": "value", "path": "system"}], "rules": "open"}, "min": 1, "mustSupport": true},
      {"id": "Basic.identifier:journalLine", "path": "Basic.identifier", "sliceName": "journalLine", "short": "Composite <JE_HEADER_ID>-<JE_LINE_NUM>", "min": 1, "max": "1"},
      {"id": "Basic.identifier:journalLine.system", "path": "Basic.identifier.system", "min": 1, "fixedUri": "https://id.healix.example.org/oracle/gl-journal-line"},
      {"id": "Basic.identifier:journalLine.value", "path": "Basic.identifier.value", "min": 1},
      {"id": "Basic.identifier:journalHeaderId", "path": "Basic.identifier", "sliceName": "journalHeaderId", "min": 1, "max": "1"},
      {"id": "Basic.identifier:journalHeaderId.system", "path": "Basic.identifier.system", "min": 1, "fixedUri": "https://id.healix.example.org/oracle/gl-journal-header-id"},
      {"id": "Basic.code", "path": "Basic.code", "min": 1, "mustSupport": true, "patternCodeableConcept": {"coding": [{"system": "https://fhir.healix.example.org/CodeSystem/healix-erp-resource-type", "code": "gl-journal-line"}]}},
      {"id": "Basic.subject", "path": "Basic.subject", "short": "Legal entity (Organization type legal-entity) owning the ledger", "min": 1, "type": [{"code": "Reference", "targetProfile": ["https://fhir.healix.example.org/StructureDefinition/healix-organization"]}], "mustSupport": true},
      {"id": "Basic.subject.identifier", "path": "Basic.subject.identifier", "min": 1},
      {"id": "Basic.created", "path": "Basic.created", "short": "Accounting effective date (GL_JE_HEADERS.DEFAULT_EFFECTIVE_DATE)", "min": 1, "mustSupport": true},
      {"id": "Basic.author", "path": "Basic.author", "short": "Posting user or integration Device", "type": [{"code": "Reference", "targetProfile": ["https://fhir.healix.example.org/StructureDefinition/healix-practitioner", "http://hl7.org/fhir/StructureDefinition/Device"]}]}
    ]
  }
}
