{
  "meta": {
    "name": "PureScore Lifestyle Axes, Archetypes & Perceived-vs-Actual model",
    "version": "1.0",
    "flag": "illustrative-reverify — design documentation, not a validated medical device (README §5.6)",
    "idea": "Any person = a vector over independent lifestyle axes. Named archetypes are common presets (nearest-vector). The PERCEIVED persona (self-report: Q_CORE_SELF_PERSONA, Q_CORE_SELF_HEALTH, goal/PRO answers) is compared with the ACTUAL persona derived from labs + wearables + validated answers; the gap drives nudge strategy (Doc 07) and adherence framing.",
    "links": ["Doc 05 sex-specific", "Doc 07 nudge engine", "Doc 12 companion vector (Representativeness/Modifiability)", "Doc 15 UAE", "Appendix C question bank", "Appendix D clinical personas"]
  },
  "axes": [
    { "id": "activity", "name": "Physical activity", "levels": ["sedentary", "lightly_active", "active", "very_active", "athlete"],
      "pillars": ["FIT", "CV", "MET", "BCM"],
      "perceived_signal": ["Q_CORE_SELF_PERSONA", "Q_FIT_*", "IPAQ-SF"],
      "actual_signal": ["wearable.MVPA", "wearable.steps", "wearable.vo2max", "FIT pillar score"] },
    { "id": "diet_pattern", "name": "Diet pattern", "levels": ["western_poor", "standard", "improving", "mediterranean", "plant_based", "low_carb_keto", "high_protein"],
      "pillars": ["NUT", "MET", "CV", "HEP", "INF"],
      "perceived_signal": ["DIET", "Q_NUTGI_*", "Q_CARDIOMET_DIETARY_PATTERN"],
      "actual_signal": ["lab.omega3_index", "lab.fiber_intake", "lab.HbA1c", "lab.ApoB", "lab.LDL-C"] },
    { "id": "sleep", "name": "Sleep & circadian", "levels": ["severe_debt", "mild_debt", "adequate", "optimal"],
      "pillars": ["SLP", "MCS", "MET", "INF"],
      "perceived_signal": ["ISI", "Q_SLEEP_*"],
      "actual_signal": ["wearable.sleep_duration", "wearable.sleep_regularity", "wearable.spo2"] },
    { "id": "substance", "name": "Substance use", "levels": ["none", "light_social", "moderate", "heavy", "polysubstance"],
      "pillars": ["HEP", "CV", "INF", "HEM", "MCS"],
      "perceived_signal": ["AUDIT-C", "SUBSTANCE", "Q_CORE_SMOKING", "Q_CORE_ALCOHOL"],
      "actual_signal": ["lab.GGT", "lab.MCV", "lab.cotinine", "lab.ALT"] },
    { "id": "stress_load", "name": "Stress / allostatic load", "levels": ["low", "moderate", "high", "chronic_severe"],
      "pillars": ["MCS", "ENDO", "CV"],
      "perceived_signal": ["PSS-4", "Q_MIND_STRESS_RATING", "Q_CORE_ACE"],
      "actual_signal": ["wearable.hrv", "lab.cortisol_rhythm", "wearable.resting_hr"] },
    { "id": "social_connection", "name": "Social connection", "levels": ["isolated", "limited", "connected", "highly_connected"],
      "pillars": ["MCS"],
      "perceived_signal": ["UCLA-3", "Q_CORE_MARITAL"],
      "actual_signal": ["app.engagement", "household.account_links"] },
    { "id": "life_stage", "name": "Life stage", "levels": ["young_adult", "reproductive", "perimenopause_andropause", "older_adult", "advanced_age"],
      "pillars": ["ENDO", "BCM", "CV", "REN"],
      "perceived_signal": ["Q_CORE_AGE", "Q_CORE_SEX", "Q_ENDO_*"],
      "actual_signal": ["lab.FSH", "lab.E2", "lab.testosterone", "age"] },
    { "id": "condition_load", "name": "Chronic-condition load", "levels": ["none", "single", "multi_morbid", "complex"],
      "pillars": ["all"],
      "perceived_signal": ["*_DX questions", "Q_CORE_FAMHX"],
      "actual_signal": ["lab panel reds", "critical pillars (Doc 03 §4)"] },
    { "id": "metabolic_state", "name": "Metabolic state", "levels": ["optimal", "at_risk", "prediabetic", "metabolic_syndrome", "diabetic"],
      "pillars": ["MET", "CV", "HEP", "BCM"],
      "perceived_signal": ["Q_CARDIOMET_IR_SYMPTOMS", "Q_CARDIOMET_DM_DX"],
      "actual_signal": ["lab.HbA1c", "lab.fasting_glucose", "lab.HOMA-IR", "lab.triglycerides", "bcm.waist", "wearable.cgm_tir"] },
    { "id": "body_composition", "name": "Body composition", "levels": ["lean", "normal", "overweight", "obese", "sarcopenic"],
      "pillars": ["BCM", "MET", "FIT"],
      "perceived_signal": ["Q_CORE_BMI", "Q_CORE_SELF_PERSONA"],
      "actual_signal": ["bcm.bmi", "bcm.body_fat_pct", "bcm.almi", "bcm.waist", "bcm.grip_strength"] },
    { "id": "work_pattern", "name": "Work / circadian pattern", "levels": ["day_regular", "irregular", "shift_worker", "frequent_traveler"],
      "pillars": ["SLP", "MCS", "MET"],
      "perceived_signal": ["Q_CORE_OCCUPATION", "Q_SLEEP_SHIFT_WORK"],
      "actual_signal": ["wearable.sleep_regularity", "calendar.timezone_changes"] },
    { "id": "engagement", "name": "Engagement / adherence", "levels": ["disengaged", "ambivalent", "motivated", "highly_engaged"],
      "pillars": ["behavioural (not scored as health, Doc 04 inflows / Doc 07 feasibility)"],
      "perceived_signal": ["Q_CORE_GOALS", "Q_CORE_SELF_PERSONA"],
      "actual_signal": ["app.streaks", "nudge.completion_rate", "wearable.wear_time"] }
  ],
