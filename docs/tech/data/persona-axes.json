  "perceived_vs_actual": {
    "method": "For each axis, compute perceived_level from self-report (question bank GOAL/perceived items) and actual_level from objective signals (labs + wearables + validated PROs). gap = perceived_level − actual_level. The signed gap selects a nudge/communication strategy and adjusts the companion vector (Doc 12: Representativeness, Modifiability, Confidence). Large positive gap (over-estimates own health) → awareness-first; large negative gap (catastrophizing) → reassurance-first.",
    "gaps": [
      { "id": "overconfident_fitness", "axis": "activity", "perceived": "active/athlete", "actual": "sedentary",
        "signal": "self-rated active but wearable.MVPA <75 min/wk", "strategy": "Show the data gently; reframe with one concrete movement target; avoid shaming.", "companion_effect": "Modifiability high, Confidence moderate" },
      { "id": "hidden_metabolic", "axis": "metabolic_state", "perceived": "optimal", "actual": "prediabetic/diabetic",
        "signal": "feels well but lab.HbA1c ≥5.7 / waist high", "strategy": "Awareness-first: explain silent risk, propose confirmatory test + one diet/activity swap.", "companion_effect": "Early-warning ↑, Criticality context" },
      { "id": "catastrophizer", "axis": "condition_load", "perceived": "poor health", "actual": "good/green",
        "signal": "self-health poor but pillars green", "strategy": "Reassurance + validation; redirect anxiety into a small mastery action; consider GAD-7.", "companion_effect": "Confidence ↑, MCS attention" },
      { "id": "overtrainer", "axis": "activity", "perceived": "peak fitness", "actual": "poor recovery",
        "signal": "high training load but wearable.hrv low / sleep debt", "strategy": "Validate effort, prescribe deload/recovery; frame rest as performance.", "companion_effect": "Trajectory ↓ flag, FIT down-weight" },
      { "id": "stoic_underreporter", "axis": "stress_load", "perceived": "fine", "actual": "chronic_severe",
        "signal": "denies stress but HRV low / cortisol flat", "strategy": "Normalize, use objective data as neutral entry; soft MCS screen (PSS-4).", "companion_effect": "ENDO/MCS attention" },
      { "id": "diet_halo", "axis": "diet_pattern", "perceived": "healthy diet", "actual": "poor",
        "signal": "reports healthy but lab.omega3_index <4 / fiber low / ApoB high", "strategy": "Specific food swaps tied to the deficient marker, not generic 'eat better'.", "companion_effect": "NUT/CV targeted" },
      { "id": "alcohol_blindspot", "axis": "substance", "perceived": "light social", "actual": "moderate/heavy",
        "signal": "AUDIT-C low but GGT/MCV elevated", "strategy": "Non-judgmental teach-back of units; liver framing; brief intervention.", "companion_effect": "HEP attention, Confidence cross-check" }
    ]
  }
}
