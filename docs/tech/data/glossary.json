{
 "_meta": {
  "source": "hand-curated + merged from acronyms.json",
  "note": "Canonical unified glossary feeding both the Glossary page (build_glossary) and the wiki-wide hover tooltips (assets/acronyms.js via _write_hover_data). Lenses: clinical / product / technical. 'rulings' is the terminology-standardization register (D-series).",
  "lenses": {
   "clinical": "Clinical term",
   "product": "Product / Mobile-UI term",
   "technical": "Technical / engine term"
  }
 },
 "rulings": [
  {
   "id": 1,
   "concept": "First-time setup flow",
   "canonical": "Onboarding",
   "variants": [
    "first-run",
    "sign-up",
    "registration"
   ],
   "lenses": [
    "product"
   ],
   "status": "approved",
   "ruling": "Use <b>Onboarding</b> for the one-time first-run experience (demographics, consent, cold-start). 'First-run' is an informal alias only. Onboarding is the first phase of <b>Intake</b>."
  },
  {
   "id": 2,
   "concept": "Ongoing data collection (the question/answer system)",
   "canonical": "Intake",
   "variants": [],
   "lenses": [
    "product"
   ],
   "status": "approved",
   "ruling": "Bare <b>Intake</b> = the product data-collection umbrella (Onboarding + Progressive profiling + Check-ins). The clinical sense must always be qualified: write <b>dietary intake</b> or <b>reservoir inflow</b>, never bare 'intake'."
  },
  {
   "id": 3,
   "concept": "Collecting more user attributes over time",
   "canonical": "Progressive profiling",
   "variants": [
    "progressive data (collection)",
    "staged profiling",
    "progressive disclosure"
   ],
   "lenses": [
    "product"
   ],
   "status": "approved",
   "ruling": "Use <b>Progressive profiling</b> for gradually gathering user attributes/demographics across sessions. The data-quality chapter is renamed to <b>Data quality &amp; graceful degradation</b> so 'progressive' no longer collides with the degradation pipeline."
  },
  {
   "id": 4,
   "concept": "System↔user interaction",
   "canonical": "Nudge (outbound) / Check-in (inbound)",
   "variants": [
    "micro-action",
    "daily action",
    "prompt"
   ],
   "lenses": [
    "product"
   ],
   "status": "approved",
   "ruling": "<b>Nudge</b> = a system→user prompt suggesting a behaviour/action (the nudge engine). <b>Check-in</b> = a system→user prompt <i>requesting</i> data (mood/stress/adherence self-report). An <b>adherence check-in</b> is a check-in confirming a prescribed action was done."
  },
  {
   "id": 5,
   "concept": "Care construct",
   "canonical": "Care pathway (protocol) / Care plan (instance)",
   "variants": [
    "treatment plan",
    "care program"
   ],
   "lenses": [
    "clinical",
    "product"
   ],
   "status": "approved",
   "ruling": "<b>Care pathway</b> = the standardized condition-level clinical PROTOCOL/template (IEAT lifecycle). <b>Care plan</b> = the PERSONALIZED instance generated for one user from a pathway (their bundle of interventions + goals). A care plan is an instance of a care pathway."
  },
  {
   "id": 6,
   "concept": "Desired aim",
   "canonical": "Goal (user) / Target (setpoint)",
   "variants": [
    "objective",
    "aspiration"
   ],
   "lenses": [
    "product",
    "technical"
   ],
   "status": "approved",
   "ruling": "<b>Goal</b> = the user-stated aspiration that personalizes scoring/actions (drives m_k^goal). <b>Target</b> = a technical/clinical setpoint or threshold (reservoir B^target, calibration target, validation target population). Never use 'target' to mean a user goal."
  },
  {
   "id": 7,
   "concept": "Questionnaire family",
   "canonical": "Instrument (set) · screener (subtype) · PRO (channel)",
   "variants": [
    "questionnaire",
    "survey",
    "self-report",
    "assessment (misuse)"
   ],
   "lenses": [
    "clinical",
    "technical"
   ],
   "status": "approved",
   "ruling": "<b>Instrument</b> = any validated question set (absorbs 'questionnaire'/'survey'). <b>Screener</b> = a defined subtype: a short triage instrument (e.g. PHQ-2). <b>PRO (patient-reported outcome)</b> = the input channel/modality (absorbs 'self-report'). <b>Assessment</b> is reserved for a clinical risk-assessment process — never for a questionnaire."
  },
  {
   "id": 8,
   "concept": "The 12 health systems",
   "canonical": "Pillar",
   "variants": [
    "domain (evidence-ID token only)",
    "health system",
    "axis"
   ],
   "lenses": [
    "technical",
    "product"
   ],
   "status": "approved",
   "ruling": "<b>Pillar</b> is the one canonical term for the 12 systems in all prose. <b>Domain</b> is permitted ONLY as the frozen field/ID token in the evidence registry (EVD-&lt;DOMAIN&gt;-…), where renaming would break stable keys."
  },
  {
   "id": 9,
   "concept": "A measured/scored quantity",
   "canonical": "Marker",
   "variants": [
    "biomarker",
    "metric (derived only)",
    "signal (informal)"
   ],
   "lenses": [
    "clinical",
    "technical"
   ],
   "status": "approved",
   "ruling": "<b>Marker</b> = any scored input (lab, wearable or PRO). 'Biomarker' is an alias of marker. <b>Metric</b> is reserved for a derived/computed value (e.g. HRV from raw beats). 'Signal' is informal — avoid in spec prose."
  }
 ],
