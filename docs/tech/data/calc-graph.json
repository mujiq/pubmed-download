 "engine_params": {
  "conf_floor": 0.5,
  "tau_days": 120,
  "stale_dt_days": 60,
  "q_source": {
   "clinical": 1.0,
   "lab": 0.95,
   "wearable": 0.8,
   "pro": 0.7
  },
  "_note": "Illustrative confidence/missing-data model (Doc 01 §2 · D22 trust tiers · D33 cold-start). confidence = q_source[channel] · exp(−Δt/τ); present → Δt 0, stale → Δt = stale_dt_days, missing → 0. Missing & imputable markers impute to the age×sex×life-stage cohort median (D33) — here the marker default stands in as the illustrative cohort median; missing & non-imputable markers drop from the pillar mean and lower Confidence."
 },
 "gates": [
  {
   "id": "sex",
   "label": "Sex model",
   "area": "gate",
   "question": "sex?",
   "attr": "sex",
   "doc": "05",
   "formula": "sex ∈ {male, female} selects reference cut-points, pillar emphases and the sex-gated question set (D27).",
   "branches": [
    {
     "id": "male",
     "label": "Male — male cut-points, ENDO/HEM emphasis",
     "when": "male"
    },
    {
     "id": "female",
     "label": "Female — female cut-points, ENDO/BCM/HEM emphasis",
     "when": "female"
    }
   ]
  },
  {
   "id": "preg",
   "label": "Pregnancy frame",
   "area": "gate",
   "question": "pregnant?",
   "attr": "preg",
   "doc": "06",
   "formula": "Pregnancy applies physiologic-shift ranges and pre-eclampsia / GDM anchors; gates female-only items.",
   "branches": [
    {
     "id": "no",
     "label": "not pregnant → standard ranges",
     "when": "not_preg"
    },
    {
     "id": "yes",
     "label": "pregnant → pregnancy frame (physiologic shifts, PE/GDM anchors)",
     "when": "preg"
    }
   ]
  },
  {
   "id": "age",
   "label": "Age band",
   "area": "gate",
   "question": "age band?",
   "attr": "age",
   "doc": "04",
   "formula": "Guideline age-banding where it exists (BP J-curve, age-normed fitness) + frailty frames at 65+ (D4).",
   "branches": [
    {
     "id": "young",
     "label": "< 40",
     "when": "age_lt_40"
    },
    {
     "id": "mid",
     "label": "40–64",
     "when": "age_40_64"
    },
    {
     "id": "older",
     "label": "65+ — J-curve & frailty frames",
     "when": "age_65p"
    }
   ]
  },
  {
   "id": "lifestage",
   "label": "Life-stage frame",
   "area": "gate",
   "question": "life-stage?",
   "attr": "lifestage",
   "doc": "06",
   "formula": "Life-stage selects the special frame (reproductive · pregnancy · perimenopause · andropause · older-adult).",
   "branches": [
    {
     "id": "adult",
     "label": "general adult (no special frame)",
     "when": "ls_adult"
