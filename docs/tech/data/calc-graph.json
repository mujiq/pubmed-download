 "roots": {
  "purescore": {
   "label": "PureScore",
   "formula": "PureScore = round(100 · (1 − R_total));  capped at PURE_CRIT_CAP when any pillar critical",
   "output": "0–100",
   "doc": "03",
   "nodes": {
    "r_total": {
     "label": "R_total",
     "formula": "R_total = (Σ_k Wk · R_k^δ)^(1/δ)  ·  δ-power-mean, δ from constants",
     "cRef": [
      "δ"
     ],
     "doc": "03"
    },
    "pillar": {
     "label": "Pillar R_k",
     "formula": "R_k = clamp01( mean(r_marker) + ρ · mean(reservoir load) ); critical red → R_k = max(R_k, R_crit)",
     "cRef": [
      "ρ_k",
      "R_crit"
     ],
     "doc": "02"
    },
    "marker": {
     "label": "Marker pipeline",
     "stages": [
      {
       "id": "conf",
       "label": "Confidence + decay",
       "formula": "confidence = q_source · exp(−Δt/τ); below floor → stale/missing → fallback (D33)",
       "doc": "01",
       "branches": [
        {
         "id": "ok",
         "label": "present → use measured value",
         "when": "present"
        },
        {
         "id": "stale",
         "label": "stale → decay confidence, blend r toward neutral",
         "when": "stale"
        },
        {
         "id": "impute",
         "label": "missing & imputable → cohort median, low confidence (D33)",
         "when": "missing_imputable"
        },
        {
         "id": "drop",
         "label": "missing & non-imputable → drop from pillar mean, Confidence↓",
         "when": "missing_nonimputable"
        }
       ]
      },
      {
       "id": "band",
       "label": "Clinical band r_clin",
       "formula": "r off the continuous curve via th = [yellow, red, dir] → green .10 / yellow .40 / red .66",
       "doc": "03"
      },
      {
       "id": "cohort",
       "label": "Cohort percentile r_cohort",
       "formula": "r_cohort = F_ic(x) percentile (NHANES / UK-Biobank)",
       "doc": "01"
      },
      {
       "id": "blend",
       "label": "max(r_clin, φ·r_cohort)",
       "formula": "φ from constants — cohort can only RAISE, clinical anchor never diluted",
       "cRef": [
        "φ"
       ],
       "doc": "03",
       "branches": [
        {
         "id": "raise",
         "label": "φ·r_cohort > r_clin → cohort raises r",
         "when": "cohort_raises"
        },
        {
         "id": "anchor",
         "label": "else → clinical anchor holds",
         "when": "clinical_anchor"
        }
       ]
      },
      {
       "id": "pers",
       "label": "Personalization + clamp",
       "formula": "band_clamp(r + r_pers · 𝟙[non-critical]); r_pers = κ_resp · tanh(z/2)",
       "cRef": [
        "κ_resp"
       ],
       "doc": "03",
       "branches": [
        {
         "id": "on",
         "label": "non-critical → apply r_pers = κ_resp · tanh(z/2)",
         "when": "noncritical"
        },
        {
         "id": "off",
         "label": "critical marker → personalization DISABLED",
         "when": "critical"
        }
       ]
      },
      {
       "id": "crit",
       "label": "Critical cascade",
       "formula": "critical-marker red → pillar R_k ← max(R_k, R_crit); never averaged away",
       "cRef": [
        "R_crit"
       ],
       "doc": "03",
       "branches": [
        {
         "id": "fire",
         "label": "critical & red → floor pillar R_k to R_crit ⚑",
         "when": "crit_red"
        },
        {
         "id": "pass",
         "label": "else → pass through",
         "when": "not_crit_red"
        }
       ]
      }
     ]
    },
    "reservoir": {
     "label": "Reservoir load L_j",
     "formula": "L_j ∈ [0,1]; base from nrm(value, good, bad) then coupling (leak/interference, Doc 04); contributes ρ·L to its pillar",
     "cRef": [
      "ρ_k"
     ],
     "doc": "04"
    }
   }
  },
  "companion": {
   "label": "Companion vector",
   "formula": "(Confidence · Trajectory · early-warning) — carried alongside the scalar score",
   "doc": "12",
   "nodes": {
    "confidence": {
     "label": "Confidence",
     "formula": "weighted data freshness × source quality across pillars",
     "doc": "12"
    },
    "trajectory": {
     "label": "Trajectory",
     "formula": "Δ PureScore vs prior period (↑ improving / ↓ worsening)",
     "doc": "12"
    },
    "ew": {
     "label": "Early-warning",
     "formula": "ON when any pillar critical or a syndromic detector fires",
     "doc": "12"
    }
   }
  },
  "nudge": {
   "label": "Nudge utility U_a",
   "formula": "U_a = impact_a · p̂_a · ease_a — every recommended action has positive Δ PureScore; top-5 surfaced",
   "doc": "07",
   "nodes": {
    "impact": {
     "label": "impact_a",
     "formula": "expected Δ PureScore if action a fully adopted (worst-pillar leaning)",
     "doc": "07"
    },
    "phat": {
     "label": "p̂_a",
     "formula": "predicted adoption probability (recalibrated from realized adherence)",
     "doc": "07"
    },
    "ease": {
     "label": "ease_a",
     "formula": "modifiability / effort gate (D16) — low-effort, high-yield first",
     "doc": "07"
    }
   }
  },
  "adherence": {
   "label": "Adherence → reservoir inflow",
   "formula": "adherence ∈ [0,1] (7-day EWMA of EHR-triggered check-ins) → inflow to the relevant reservoir",
   "doc": "appendix-adherence.html",
   "nodes": {
    "ewma": {
     "label": "7-day EWMA",
     "formula": "adherence_t = α·obs_t + (1−α)·adherence_{t−1}",
     "doc": "appendix-adherence.html"
    },
    "inflow": {
     "label": "Reservoir inflow",
     "formula": "inflow_j = adherence · k_j → drains a burden / fills a reserve over time (Doc 04)",
     "doc": "04"
    }
   }
  },
  "actuarial": {
   "label": "Actuarial premium",
   "formula": "relative risk from PureScore → premium multiplier (firewalled, off by default)",
   "doc": "10",
   "nodes": {
    "rr": {
     "label": "Relative risk",
     "formula": "RR = g(PureScore, age, sex) calibrated to cohort hazard",
     "doc": "10"
    },
    "premium": {
     "label": "Premium multiplier",
     "formula": "premium = base · (1 + β · (RR − 1)); regulatory caps applied",
     "doc": "10"
    }
   }
  }
 },
