  "steps": [
    {"order": 1, "id": "welcome", "phase": "Welcome", "screen": "Value proposition + privacy summary", "captures": "—", "consent": false, "pairs_device": false, "gated_until": "—", "feeds": "—", "why": "Set expectations; surface the privacy posture before any data is asked."},
    {"order": 2, "id": "account", "phase": "Account", "screen": "Email / SSO + display name", "captures": "identity", "consent": false, "pairs_device": false, "gated_until": "—", "feeds": "account", "why": "Create the account record (Doc 01 Patient)."},
    {"order": 3, "id": "consent_privacy", "phase": "Consent", "screen": "Privacy & data-use consent", "captures": "consent flags", "consent": true, "pairs_device": false, "gated_until": "blocks all data capture", "feeds": "governance (Doc 11)", "why": "Informed consent precedes any PII/health capture; granular toggles (care vs research vs actuarial-firewalled)."},
    {"order": 4, "id": "demographics", "phase": "Profile", "screen": "Sex at birth · gender · DOB · height · weight · ethnicity · pregnancy status", "captures": "demographic field-set", "consent": false, "pairs_device": false, "gated_until": "after consent", "feeds": "cohort + reference frames (Doc 01/05/15)", "why": "Drives age/sex frames, cohort stratification and UAE cut-points — the minimum to interpret any marker."},
    {"order": 5, "id": "goal_seed", "phase": "Goals", "screen": "What brings you here? (pick 1–3)", "captures": "goal intents", "consent": false, "pairs_device": false, "gated_until": "—", "feeds": "goals (Appendix J)", "why": "Seeds the UserGoals stream and tilts the first nudges; warm, motivating first step."},
    {"order": 6, "id": "bootstrap_pro", "phase": "Quick check-in", "screen": "PHQ-2 · GAD-2 · sleep · activity · alcohol · smoking · diet (≈ 2 min)", "captures": "minimal high-yield PROs", "consent": false, "pairs_device": false, "gated_until": "after consent", "feeds": "cold-start score + persona signals", "why": "The cheapest item set that bootstraps an initial score and resolves a persona (F11)."},
    {"order": 7, "id": "persona_resolve", "phase": "Personalize", "screen": "(silent) determination-matrix posterior → frame", "captures": "—", "consent": false, "pairs_device": false, "gated_until": "after bootstrap", "feeds": "persona frame (Appendix I)", "why": "Resolve to a coherent persona/archetype so even early scoring is framed, not generic."},
    {"order": 8, "id": "device_pair", "phase": "Connect", "screen": "Pair a wearable (optional, skippable)", "captures": "device tokens", "consent": false, "pairs_device": true, "gated_until": "gates wearable-derived metrics & wearable early-warning", "feeds": "WEAR stream (Doc 18, D22)", "why": "Position device-pairing explicitly; wearable metrics/trends stay locked until a device is paired (F12)."},
    {"order": 9, "id": "ehr_connect", "phase": "Records", "screen": "Connect EHR / labs (optional)", "captures": "FHIR auth", "consent": false, "pairs_device": false, "gated_until": "gates Patient360 corroboration & auto-activated check-ins", "feeds": "LAB stream + Patient360 (Doc 01 §1)", "why": "EHR-first activation: known meds/conditions auto-activate the right check-ins instead of re-asking."},
    {"order": 10, "id": "first_score", "phase": "Your score", "screen": "Cold-start PureScore + companion vector (Confidence shown LOW)", "captures": "—", "consent": false, "pairs_device": false, "gated_until": "after bootstrap", "feeds": "score + companion (Doc 12)", "why": "Show value immediately; honesty via low Confidence + 'measure this' coverage prompts (ignition, Doc 14)."},
    {"order": 11, "id": "progressive", "phase": "Ongoing", "screen": "Schedule rest of bank by priority over later sessions", "captures": "progressive answers", "consent": false, "pairs_device": false, "gated_until": "post first-run", "feeds": "question bank (Appendix E)", "why": "Progressive profiling: never front-load the whole question bank; deepen coverage as engagement allows (F11)."}
