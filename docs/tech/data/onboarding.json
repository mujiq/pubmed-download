      {"ref": "Sleep duration/regularity", "why": "→ SLP + persona (shift/new-parent)", "pillar": "SLP"},
      {"ref": "IPAQ-SF (1 item)", "why": "→ FIT + persona (sedentary/athlete)", "pillar": "FIT"},
      {"ref": "AUDIT-C", "why": "→ HEP/MCS + persona (social-drinker)", "pillar": "HEP"},
      {"ref": "Smoking status", "why": "→ CV/INF cross-cutting + persona", "pillar": "CV"},
      {"ref": "Diet-quality (1 item)", "why": "→ NUT/MET + persona", "pillar": "NUT"}
