{
 "_meta": {
  "note": "Canonical wearable-metric registry — the spine of the baseline pipeline. Per metric: group (individual/aggregated/derived/frequency), canonical unit + SI, sampling frequency, raw→day aggregation, plausibility gate, trust tier, the source mapping (Terra resource/field, Apple HealthKit type, Google Health Connect record, device-cloud field) with each source's native unit + transform to canonical, the baseline-formula id (see baseline-formulas.json), and the DQ rule classes that apply (see baseline-dq-rules.json). Illustrative; re-verify against live Terra/HealthKit/vendor schemas before production (README §5.6).",
  "groups": {
   "individual": "a single instantaneous reading (spot value)",
   "aggregated": "a summary over a period reduced from raw samples (mean/sum)",
   "derived": "computed from an algorithm or other metrics",
   "frequency": "a count or rate per unit time"
  },
  "canonicalization": "All sources transformed to the canonical unit before any baseline math. SI stored internally; conventional shown in UI (see units.json policy).",
  "merge_policy": "trust-tier → within-tier higher native resolution → freshest non-stale sample; overlapping intervals de-duplicated; conflicts logged (see baseline-sources.json)."
 },
 "metrics": {
  "resting_hr": {
   "label": "Resting heart rate",
   "pillar": "CV",
   "group": "aggregated",
   "canon": "bpm",
   "si": "bpm",
   "freq": "1 value/day (computed from overnight/sedentary samples)",
   "agg": "min/trimmed-mean of overnight HR samples",
   "plaus": {
    "min": 25,
    "max": 220,
    "zero": "missing"
   },
   "trust": "wearable-consumer",
   "sources": {
    "terra": {
     "path": "daily.heart_rate_data.summary.resting_hr_bpm",
     "unit": "bpm",
     "xform": "identity"
    },
    "healthkit": {
     "type": "HKQuantityTypeIdentifierRestingHeartRate",
     "unit": "count/min",
     "xform": "identity"
    },
    "healthconnect": {
     "record": "RestingHeartRateRecord",
     "unit": "bpm",
     "xform": "identity"
    },
    "devicecloud": {
     "oura": "daily_readiness.contributors.resting_heart_rate / sleep.lowest_heart_rate",
     "whoop": "recovery.resting_heart_rate",
     "garmin": "dailies.restingHeartRateInBeatsPerMinute",
     "fitbit": "activities-heart.value.restingHeartRate",
     "unit": "bpm"
    }
   },
   "formula": "robust_rolling",
   "dq": [
    "gap",
    "battery",
    "stale",
    "outlier",
    "zero_vs_missing",
    "device_switch",
    "multi_source_overlap",
    "cold_start"
   ]
  },
  "hrv_rmssd": {
   "label": "Heart-rate variability (RMSSD)",
   "pillar": "CV",
   "group": "derived",
   "canon": "ms",
   "si": "ms",
   "freq": "1 value/night (overnight) or 5-min epochs",
   "agg": "median of overnight RMSSD epochs",
   "plaus": {
    "min": 1,
    "max": 300,
    "zero": "missing"
   },
   "trust": "wearable-consumer",
   "sources": {
    "terra": {
     "path": "daily.heart_rate_data.summary.avg_hrv_rmssd",
     "unit": "ms",
     "xform": "identity"
    },
    "healthkit": {
     "type": "HKQuantityTypeIdentifierHeartRateVariabilitySDNN",
     "unit": "ms",
     "xform": "rmssd_from_sdnn_NOT_DIRECT",
     "trap": "Apple reports SDNN, not RMSSD — they are different HRV metrics and not interconvertible. Store as a distinct SDNN series; do NOT pool with RMSSD without an explicit, validated mapping."
    },
    "healthconnect": {
     "record": "HeartRateVariabilityRmssdRecord",
     "unit": "ms",
     "xform": "identity"
    },
    "devicecloud": {
     "oura": "sleep.rmssd / daily_readiness hrv_balance",
     "whoop": "recovery.hrv_rmssd_milli (ms)",
     "garmin": "hrv summary",
     "unit": "ms"
    }
   },
   "formula": "robust_rolling_log",
   "dq": [
    "metric_definition_mismatch",
    "gap",
    "battery",
    "stale",
    "outlier",
    "log_skew",
    "multi_source_overlap",
    "cold_start",
    "device_switch"
   ]
  },
  "spo2": {
   "label": "Peripheral oxygen saturation (SpO₂)",
   "pillar": "HEM",
   "group": "individual",
   "canon": "%",
   "si": "%",
   "freq": "spot or overnight continuous",
   "agg": "median (spot) / min-nadir (overnight)",
   "plaus": {
    "min": 70,
    "max": 100,
    "zero": "implausible_drop"
   },
   "trust": "wearable-consumer",
   "sources": {
    "terra": {
     "path": "daily.oxygen_data.saturation_samples[].percentage",
     "unit": "%",
     "xform": "identity"
    },
    "healthkit": {
     "type": "HKQuantityTypeIdentifierOxygenSaturation",
     "unit": "fraction 0–1",
     "xform": "x100",
     "trap": "Apple stores a FRACTION (0.97), not a percent — multiply by 100."
    },
    "healthconnect": {
     "record": "OxygenSaturationRecord",
     "unit": "%",
     "xform": "identity"
    },
    "devicecloud": {
     "oura": "spo2.spo2_percentage.average",
     "garmin": "pulseOx",
     "unit": "%"
    }
   },
   "formula": "robust_rolling",
   "dq": [
    "unit_drift",
    "outlier",
    "zero_vs_missing",
    "motion_artifact",
    "gap",
    "stale",
    "multi_source_overlap"
   ]
  },
  "skin_temp_dev": {
   "label": "Skin / wrist temperature deviation",
   "pillar": "INF",
   "group": "derived",
   "canon": "°C deviation",
   "si": "°C",
   "freq": "1 value/night",
   "agg": "nightly mean deviation vs personal baseline",
   "plaus": {
    "min": -5,
    "max": 5,
    "zero": "valid_baseline"
   },
   "trust": "wearable-consumer",
   "sources": {
    "terra": {
     "path": "daily.temperature_data.body_temperature_samples / temperature_deviation",
     "unit": "°C or °C-dev",
     "xform": "abs_to_dev_if_absolute"
    },
    "healthkit": {
     "type": "HKQuantityTypeIdentifierAppleSleepingWristTemperature",
     "unit": "°C (absolute)",
     "xform": "subtract_personal_baseline",
     "trap": "Apple gives ABSOLUTE wrist temperature; Oura gives a DEVIATION. Convert absolute→deviation against the same personal baseline before pooling."
    },
    "devicecloud": {
     "oura": "daily_readiness.temperature_deviation (°C)",
     "whoop": "skin temp",
     "unit": "°C-dev"
    }
   },
   "formula": "ewma_deviation",
   "dq": [
    "absolute_vs_deviation_mismatch",
    "fahrenheit_celsius",
    "gap",
    "battery",
    "outlier",
    "cold_start",
    "device_switch"
   ]
  },
  "sleep_duration": {
   "label": "Total sleep time",
   "pillar": "SLP",
   "group": "aggregated",
   "canon": "h",
   "si": "s",
   "freq": "1 session/night (may split naps)",
   "agg": "sum of asleep stages per sleep day (noon→noon window)",
   "plaus": {
    "min": 0,
    "max": 16,
    "zero": "no_sleep_recorded"
   },
   "trust": "wearable-consumer",
   "sources": {
    "terra": {
     "path": "sleep.sleep_durations_data.asleep.duration_asleep_state_seconds",
     "unit": "s",
     "xform": "div3600_to_hours"
    },
    "healthkit": {
     "type": "HKCategoryTypeIdentifierSleepAnalysis (asleep intervals)",
     "unit": "interval s",
     "xform": "sum_asleep_intervals/3600",
     "trap": "iOS sums overlapping/duplicate sleep samples from multiple apps — must merge intervals first."
    },
    "healthconnect": {
     "record": "SleepSessionRecord (+ stages)",
     "unit": "interval",
     "xform": "sum/3600"
    },
    "devicecloud": {
     "oura": "sleep.total_sleep_duration (s)",
     "whoop": "sleep.total_in_bed_time minus awake",
     "fitbit": "sleep.minutesAsleep",
     "unit": "mixed"
    }
   },
   "formula": "robust_rolling",
   "dq": [
    "timezone_dst",
    "sleep_day_window",
    "interval_overlap",
    "nap_split",
    "gap",
    "zero_vs_missing",
    "multi_source_overlap",
    "device_switch"
   ]
  },
  "sleep_efficiency": {
   "label": "Sleep efficiency",
